{
  "version": "1.3.0",
  "vectors": [
    {
      "id": "authorization-sig-001",
      "description": "Core-native encoding: Ed25519 (capitalized), expiry, base64 signature, domain-prefixed preimage",
      "mode": "valid",
      "expected": {
        "status": "ok",
        "violations": []
      }
    },
    {
      "id": "authorization-sig-002",
      "mode": "invalid-signature",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_SIGNATURE_INVALID",
            "message": "signature verification failed"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-003",
      "mode": "wrong-kid",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_KID_UNKNOWN",
            "message": "kid not found for issuer/alg"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-004",
      "mode": "wrong-issuer",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_ISSUER_MISMATCH",
            "message": "issuer does not match expectedIssuer"
          },
          {
            "code": "AUTH_KID_UNKNOWN",
            "message": "kid not found for issuer/alg"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-005",
      "mode": "wrong-audience",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_AUDIENCE_MISMATCH",
            "message": "audience does not match expectedAudience"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-006",
      "mode": "tampered-field",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_SIGNATURE_INVALID",
            "message": "signature verification failed"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-007",
      "mode": "expired",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_EXPIRED",
            "message": "authorization has expired"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-008",
      "mode": "replay",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_REPLAY",
            "message": "auth_id has already been consumed"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-009",
      "mode": "unknown-alg",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_ALG_UNSUPPORTED",
            "message": "unsupported signature algorithm"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-010",
      "description": "Sift-compatible encoding: ed25519 (lowercase), expires_at, base64url signature, non-prefixed preimage",
      "mode": "sift-wire-format",
      "expected": {
        "status": "ok",
        "violations": []
      }
    },
    {
      "id": "authorization-sig-011",
      "description": "Rejected: EdDSA is not an accepted algorithm identifier",
      "mode": "unsupported-alg-EdDSA",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_ALG_UNSUPPORTED",
            "message": "unsupported signature algorithm"
          }
        ]
      }
    },
    {
      "id": "authorization-sig-012",
      "description": "Rejected: ED25519 (all-caps) is not an accepted algorithm identifier — case matching is exact",
      "mode": "unsupported-alg-ED25519",
      "expected": {
        "status": "invalid",
        "violations": [
          {
            "code": "AUTH_ALG_UNSUPPORTED",
            "message": "unsupported signature algorithm"
          }
        ]
      }
    }
  ]
}
