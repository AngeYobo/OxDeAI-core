# API Extractor generates its committed report and temporary comparison report
# with CRLF line endings (their pre-existing convention). Without this,
# `git diff --check` flags every added line's trailing \r as a whitespace error.
# cr-at-eol treats CR as part of the line terminator (this file's convention)
# without disabling detection of genuine trailing spaces/tabs. It does not set
# `text` or `eol`, so it has no effect on line-ending normalization or how the
# file is diffed/stored.
packages/core/etc/core.api.md whitespace=cr-at-eol
packages/core/temp/core.api.md whitespace=cr-at-eol
