# Live validation environment for LGF Frappe Helpdesk PEP PoC
#
# Usage:
#   1. Copy this file to /tmp/.env.pep.live (outside the repo tree).
#   2. Fill in the real values.
#   3. Pass to docker via: --env-file /tmp/.env.pep.live
#
# NEVER commit the filled-in file.
# NEVER commit Frappe API credentials.
# NEVER commit the signing private key.
# NEVER place real secrets in any file inside this repository.

OXDEAI_MODE=enforce
EXPECTED_AUDIENCE=PEP-frappe.lgf.oxdeai.dev
FRAPPE_BASE_URL=https://frappe.lgf.oxdeai.dev
FRAPPE_API_KEY=<your-frappe-api-key>
FRAPPE_API_SECRET=<your-frappe-api-secret>
REPLAY_STORE=memory
PORT=3000

# Ed25519 signing key PEM.
#
# Option A — escaped newlines (for --env-file):
#   SIGNING_PRIVATE_KEY_PEM=<escaped-ed25519-private-key-pem>
#
# Option B — real newlines via docker run -e (preferred):
#   Omit this line from the env file and pass separately:
#   docker run ... -e "SIGNING_PRIVATE_KEY_PEM=$(cat /tmp/pep-signing-key.pem)" ...
#
SIGNING_PRIVATE_KEY_PEM=<escaped-pem-or-use-docker-run-e>
